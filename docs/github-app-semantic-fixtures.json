      "name": "first_valid_delivery",
      "input": {
        "delivery_guid": "guid-1",
        "raw_payload_digest": "sha256:aaa",
        "identity_tuple_digest": "sha256:identity-1",
        "signature": "valid",
        "repository": "baziyer/dark-factory",
        "event": "issues",
        "action": "opened"
      },
      "expected": {
        "decision": "accept",
        "durable_result": "candidate-created",
        "mutation_count": 1
      }
    },
    {
      "name": "exact_github_redelivery",
      "input": {
        "delivery_guid": "guid-1",
        "raw_payload_digest": "sha256:aaa",
        "identity_tuple_digest": "sha256:identity-1",
        "signature": "valid",
        "repository": "baziyer/dark-factory",
        "event": "issues",
        "action": "opened"
      },
      "expected": {
        "decision": "return-existing-result",
        "durable_result": "candidate-created",
        "mutation_count": 1
      }
    },
    {
      "name": "response_loss_reconciliation",
      "input": {
        "delivery_guid": "guid-1",
        "raw_payload_digest": "sha256:aaa",
        "identity_tuple_digest": "sha256:identity-1",
        "signature": "valid",
        "repository": "baziyer/dark-factory",
        "event": "issues",
        "action": "opened",
        "prior_response": "lost"
      },
      "expected": {
        "decision": "reconcile-existing-result",
        "durable_result": "candidate-created",
        "mutation_count": 1
      }
    },
