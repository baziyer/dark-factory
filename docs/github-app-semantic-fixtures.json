        "repository": "baziyer/dark-factory",
        "event": "issues",
        "action": "opened"
      },
      "expected": {
        "decision": "reject",
        "reason": "malformed_delivery_identity",
        "mutation_count": 0
      }
    },
    {
      "name": "read_only_identity_verification",
      "input": {
        "contents": "read",
        "pull_requests": "read",
        "selected_repository": "baziyer/dark-factory",
        "requires_test_commit": true,
        "requires_test_pull_request": true
      },
      "expected": {
        "decision": "temporary_authority_proposal",
        "proposal_kind": "github_app_identity_verification",
        "additional_permissions": ["contents:write", "pull_requests:write"],
        "additional_repository": "operator-must-supply-exact-disposable-repository",
        "repository_must_not_be_current_selection": true,
        "teardown_plan": [
          "delete_test_branch_and_pull_request",
          "remove_disposable_repository_from_installation",
          "revoke_temporary_authority",
          "erase_short_lived_token"
        ],
        "provider_receives_credentials": false,
        "expires": true,
        "teardown_required": true
      }
    },
    {
      "name": "target_404_after_valid_scope_check",
      "input": {
        "response_status": 404,
        "installation_check": "valid",
        "repository_scope_check": "valid",
        "target_exists": false
      },
      "expected": {
        "decision": "reconcile_target",
        "durable_state": "target_not_found",
        "mutation_allowed": false,
        "installation_revoked": false,
        "operator_attention": false
      }
    },
    {
      "name": "confirmed_repository_scope_revocation",
      "input": {
        "response_status": 404,
        "installation_check": "valid",
        "repository_scope_check": "removed",
        "target_exists": "unknown"
      },
      "expected": {
        "decision": "fail_closed",
        "durable_state": "scope_revoked",
        "mutation_allowed": false,
        "installation_revoked": true,
        "operator_attention": true
      }
    },
    {
      "name": "confirmed_installation_revocation",
      "input": {
        "response_status": 401,
