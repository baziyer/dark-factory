<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dark-factory.factoryd</string>

    <key>ProgramArguments</key>
    <array>
__PROGRAM_ARGUMENTS__
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
        <key>DARK_FACTORY_HOME</key>
        <string>__DARK_FACTORY_HOME__</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__DARK_FACTORY_HOME__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>AbandonProcessGroup</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Umask</key>
    <integer>63</integer>
    <key>StandardOutPath</key>
    <string>__DARK_FACTORY_HOME__/logs/factoryd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__DARK_FACTORY_HOME__/logs/factoryd.stderr.log</string>
</dict>
</plist>
