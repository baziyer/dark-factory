<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dark-factory.usage-monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>__FACTORY_USAGE_MONITOR__</string>
        <string>--socket</string>
        <string>__SOCKET__</string>
        <string>--project</string>
        <string>__PROJECT__</string>
        <string>--orchestrator</string>
        <string>__ORCHESTRATOR__</string>
        <string>--codex</string>
        <string>__CODEX__</string>
        <string>--codex-home</string>
        <string>__CODEX_HOME__</string>
        <string>--claude</string>
        <string>__CLAUDE__</string>
        <string>--home</string>
        <string>__HOME__</string>
        <string>--pty</string>
        <string>/usr/bin/script</string>
        <string>--timeout-seconds</string>
        <string>15</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WORKING_DIRECTORY__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Umask</key>
    <integer>63</integer>
    <key>StandardOutPath</key>
    <string>__LOG_DIRECTORY__/usage-monitor.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIRECTORY__/usage-monitor.stderr.log</string>
</dict>
</plist>
